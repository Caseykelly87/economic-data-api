# PostgreSQL connection for the macro pipeline.
DB_HOST=localhost  # or production hostname
DB_PORT=5432
DB_NAME=economic_data
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# API settings
API_ENV=development
API_TITLE=Economic Data API
API_VERSION=1.0.0

# Optional logging configuration
# LOG_LEVEL=info                       # trace, debug, info, warn, error
# LOG_FORMAT=json                      # json or pretty

# CORS (for browser clients calling the API directly)
# CORS_ORIGINS=*                       # or comma-separated origins

# Grocery data paths — when all four resolve to readable files, the
# API serves live canonical data; otherwise serves bundled fixtures.
# STORE_METRICS_PATH=/data/canonical/store_daily_metrics.parquet
# ANOMALY_FLAGS_PATH=/data/canonical/anomaly_flags.parquet
# DEPARTMENT_METRICS_PATH=/data/canonical/department_daily_metrics.parquet
# DIM_STORES_PATH=/data/canonical/dim_stores.parquet
# DETECTION_QUALITY_PATH=/data/canonical/detection_quality.json
# GROCERY_FIXTURES_DIR=app/fixtures
